$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$mol_hotkey $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$mol_check $mol_button_minor
	attr *
		^
		mol_check_checked <= checked? false
		aria-checked <= aria_checked \false
		role <= aria_role \checkbox
	sub /$mol_view_content
		<= Icon null
		<= label /
			<= Title $mol_view
				sub /
					<= title \

$mol_check_list $mol_view
	dictionary *
	Option* $mol_check
		checked? <=> option_checked*? false
		label <= option_label* /
			<= option_title* \
		enabled <= option_enabled* <= enabled true
		hint <= option_hint* \
		minimal_height 24
	options *
	keys /string
	sub <= items /$mol_check

$mol_switch $mol_check_list
	value? \

$mol_list $mol_view
	render_visible_only true
	render_over 0.1
	sub <= rows /$mol_view
		<= Gap_before $mol_view style * paddingTop <= gap_before 0
		<= Empty $mol_view
		<= Gap_after $mol_view style * paddingTop <= gap_after 0
	item_height_min* 1
	item_width_min* 1
	view_window_shift? 0
	view_window /
		0
		0

$mol_stack $mol_view

$mol_paragraph $mol_view
	line_height 24
	letter_width 7
	width_limit +Infinity
	row_width 0
	sub / <= title

$mol_dimmer $mol_paragraph
	haystack \
	needle \
	sub <= parts /$mol_view_content
	Low* $mol_paragraph
		sub /
			<= string* \
	High* $mol_paragraph
		sub /
			<= string* \

$mol_text_code_token $mol_dimmer
	attr *
		^
		mol_text_code_token_type <= type \

$mol_text_code_token_link $mol_text_code_token
	dom_name \a
	type \code-link
	attr *
		^
		href <= uri \
		target \_blank

$mol_text_code_line $mol_paragraph
	text \
	minimal_height 24
	numb_showed true
	syntax null
	uri_resolve* \
	Numb $mol_view
		sub /
			<= numb 0
	Token* $mol_text_code_token
		type <= token_type* \
		haystack <= token_text* \
		needle <= highlight \
	Token_link* $mol_text_code_token_link
		haystack <= token_text* \
		needle <= highlight \
		uri <= token_uri* \
	find_pos* null

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_clipboard $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3

$mol_icon_clipboard_outline $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z

$mol_button_copy $mol_button_minor
	blobs /$mol_blob
		<= text_blob? $mol_blob /
			/BlobPart <= text <= title
			* type \text/plain
		<= html_blob? $mol_blob /
			/BlobPart <= html \
			* type \text/html
	data *
	sub /
		<= Icon $mol_icon_clipboard_outline
		<= title \

$mol_text_code $mol_stack
	attr *
		^
		mol_text_code_sidebar_showed <= sidebar_showed false
	text \
	text_lines /string
	find_pos* null
	uri_base \
	row_themes /string
	sub /
		<= Rows $mol_list
			render_visible_only <= render_visible_only false
			rows <= rows /
				<= Row*0 $mol_text_code_line
					numb_showed <= sidebar_showed
					numb <= row_numb* 0
					theme <= row_theme* \
					text <= row_text* \
					syntax <= syntax null
					uri_resolve* <= uri_resolve* \
					highlight <= highlight \
		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$mol_textarea $mol_stack
	attr *
		^
		mol_textarea_clickable <= clickable? false
		mol_textarea_sidebar_showed <= sidebar_showed false
	event *
		keydown? <=> press? null
		pointermove? <=> hover? null
	sub /
		<= Edit $mol_textarea_edit
			value? <=> value? \
			hint <= hint \ 
			enabled <= enabled true
			spellcheck <= spellcheck true
			length_max <= length_max +Infinity
			selection? <=> selection? /number
			bring => bring
			submit? <=> submit? null
			submit_with_ctrl <= submit_with_ctrl true
		<= View $mol_text_code
			text <= value
			render_visible_only false
			row_numb* <= row_numb* 0
			sidebar_showed <= sidebar_showed
			highlight <= highlight \
			syntax <= syntax $mol_syntax2
	symbols_alt *string
		comma \<
		period \>
		dash \−
		equals \≈
		graveAccent \́
		forwardSlash \÷
		E \€
		V \✔
		X \×
		C \©
		P \§
		H \₽
		key0 \°
		key8 \•
		key2 \@
		key3 \#
		key4 \$
		key6 \^
		key7 \&
		bracketOpen \[
		bracketClose \]
		slashBack \|
	symbols_alt_ctrl *string
		space \ 
	symbols_alt_shift *string
		V \✅
		X \❌
		O \⭕
		key1 \❗
		key4 \💲
		key7 \❓
		comma \«
		period \»
		semicolon \“
		quoteSingle \”
		dash \—
		equals \≠
		graveAccent \̱
		bracketOpen \{
		bracketClose \}

$mol_textarea_edit $mol_string
	dom_name \textarea
	enter \enter
	field *
		^
		scrollTop 0

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_icon_tick $mol_icon path \M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z

$mol_check_box $mol_check
	Icon $mol_icon_tick

$bog_effects $mol_page
	title \Нужен ли здесь эффект?
	body /
		<= Intro $mol_view
			sub /
				<= subtitle \Ответ на хабровскую «Нужен ли здесь useEffect?» — те же 12 сценариев на моле
				<= Links $mol_view
					sub /
						<= Article $mol_link
							uri \https://habr.com/ru/articles/1055486/
							sub / <= article_label \Оригинальная статья
						<= Sources $mol_link
							uri \https://github.com/b-on-g/bog/tree/master/effects
							sub / <= sources_label \Исходники демо
		<= Demo01 $bog_effects_demo01
		<= Demo02 $bog_effects_demo02
		<= Demo03 $bog_effects_demo03
		<= Demo04 $bog_effects_demo04
		<= Demo05 $bog_effects_demo05
		<= Demo06 $bog_effects_demo06
		<= Demo07 $bog_effects_demo07
		<= Demo08 $bog_effects_demo08
		<= Demo09 $bog_effects_demo09
		<= Demo10 $bog_effects_demo10
		<= Demo11 $bog_effects_demo11
		<= Demo12 $bog_effects_demo12

$bog_effects_card $mol_view
	title \
	descr \
	body /
	sub /
		<= Title $mol_view
			sub / <= title
		<= Descr $mol_view
			sub / <= descr
		<= Content $mol_view
			sub <= body /

$bog_effects_demo01 $bog_effects_card
	title \01. Производное состояние
	descr \full_name — обычное вычисление из двух полей, без mem и без синхронизации
	body /
		<= First $mol_string
			hint \Имя
			value? <=> first_name? \Петр
		<= Last $mol_string
			hint \Фамилия
			value? <=> last_name? \Всемогущий
		<= Full $mol_view
			sub / <= full_name \

$bog_effects_demo02 $bog_effects_card
	title \02. Кэш дорогого вычисления
	descr \mol_mem пересчитывает visible_todos только при смене фильтра (смотри console)
	body /
		<= Filter $mol_switch
			value? <=> filter? \all
			options *
				all \Все
				active \Активные
		<= List $mol_list
			rows <= todo_rows /
	Row* $mol_view
		sub / <= row_title* \

$bog_effects_demo03 $bog_effects_card
	title \03. Состояние на сущность
	descr \У каждого пользователя свой черновик — mem_key хранит его по ключу
	body /
		<= User $mol_switch
			value? <=> user? \anna
			options *
				anna \Анна
				boris \Борис
				vera \Вера
		<= Comment $mol_textarea
			hint \Черновик комментария
			value? <=> current_comment? \

$bog_effects_demo04 $bog_effects_card
	title \04. Согласование выбора со списком
	descr \selection вычисляется из списка — удалил выбранное, оно само стало пустым
	body /
		<= List $mol_list
			rows <= item_rows /
		<= Selected $mol_view
			sub / <= selection_label \
	Row* $mol_view
		sub /
			<= Pick* $mol_button_minor
				click? <=> select*? null
				sub / <= item_name* \
			<= Del* $mol_button_minor
				click? <=> remove*? null
				sub / <= del_label \✕

$bog_effects_demo05 $bog_effects_card
	title \05. Общая логика обработчиков
	descr \Обе кнопки зовут один метод buy — вторая ещё и переходит к оплате
	body /
		<= Card $mol_view
			sub / <= product_title \
		<= Buttons $mol_view
			sub /
				<= ToCart $mol_button_major
					click? <=> to_cart? null
					sub / <= cart_label \В корзину
				<= BuyNow $mol_button_major
					click? <=> buy_now? null
					sub / <= buy_label \Купить сейчас
		<= Status $mol_view
			sub / <= status \

$bog_effects_demo06 $bog_effects_card
	title \06. Отправка формы
	descr \Пока action ждёт ответ — кнопка сама disabled, никакого сигнального состояния
	body /
		<= Name $mol_string
			hint \Имя
			value? <=> name? \
		<= Email $mol_string
			hint \Email
			value? <=> email? \
		<= Submit $mol_button_major
			enabled <= can_submit true
			click? <=> submit? null
			sub / <= submit_title \Отправить
		<= Result $mol_view
			sub / <= result \

$bog_effects_demo07 $bog_effects_card
	title \07. Один переход состояния
	descr \Чистая функция next_state вместо цепочки эффектов на каждый счётчик
	body /
		<= Buttons $mol_view
			sub /
				<= Normal $mol_button_major
					enabled <= playable true
					click? <=> place_normal? null
					sub / <= normal_label \Обычная карта
				<= Gold $mol_button_major
					enabled <= playable true
					click? <=> place_gold? null
					sub / <= gold_label \Золотая карта
		<= Score $mol_view
			sub / <= score \
		<= Reset $mol_button_minor
			click? <=> reset? null
			sub / <= reset_label \Сброс

$bog_effects_demo08 $bog_effects_card
	title \08. Родитель узнаёт без уведомлений
	descr \Тумблер и статус связаны двусторонним биндингом — ни колбэка, ни эффекта
	body /
		<= Toggle $mol_check_box
			checked? <=> light_on? false
			label / <= toggle_label \Выключатель
		<= Status $mol_view
			sub / <= light_status \

$bog_effects_demo09 $bog_effects_card
	title \09. Ленивая инициализация
	descr \Панель со счётчиком визитов не считается, пока её не раскрыли (console: init)
	body /
		<= Reveal $mol_button_minor
			click? <=> reveal? null
			sub / <= reveal_label \Показать счётчик визитов
		<= Panel $mol_view
			sub <= panel_content /
	Visits $mol_view
		sub / <= visits_label \

$bog_effects_demo10 $bog_effects_card
	title \10. Внешний источник как свойство
	descr \Тикающие часы и статус сети — реактивные свойства, подписка происходит при первом чтении
	body /
		<= Clock $mol_view
			sub / <= clock \
		<= Online $mol_view
			sub / <= online_label \

$bog_effects_demo11 $bog_effects_card
	title \11. Зависимости считаются сами
	descr \Смена темы не пересоздаёт соединение — счётчик переподключений это доказывает
	body /
		<= Room $mol_switch
			value? <=> room? \general
			options *
				general \General
				travel \Travel
				music \Music
		<= Theme $mol_switch
			value? <=> theme? \light
			options *
				light \Светлая
				dark \Тёмная
		<= Notice $mol_view
			sub / <= notice \
		<= Reconnects $mol_view
			sub / <= reconnects_label \

$bog_effects_demo12 $bog_effects_card
	title \12. Загрузка данных
	descr \Пока mem ждёт сеть — mol показывает ожидание, устаревший запрос отменяется
	body /
		<= Query $mol_string
			hint \Поиск товара
			value? <=> query? \
		<= Results $mol_list
			rows <= result_rows /
		<= Done $mol_view
			sub / <= done_label \
	Row* $mol_view
		sub / <= row_title* \
