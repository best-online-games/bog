$bog_figmol_app_canvas_shape $mol_view
	store $bog_figmol_store
	id \
	label? \
	- \Grips are drawn for somebody who can actually drag them
	editable true
	selected false
	editing false
	- \Frame is the target of the drag going on right now
	dropping false
	- \Shapes of the kids, made and owned by the canvas
	kids /$mol_view
	- \x, y, w, h in sheet pixels, x and y relative to the parent frame
	rect /number
	attr *
		^
		figmol_node <= id
		figmol_kind <= kind \rect
		figmol_selected <= selected
		figmol_flow <= flow false
		figmol_dropping <= dropping
	style *
		left <= style_left \
		top <= style_top \
		width <= style_width \
		height <= style_height \
		flexDirection <= style_direction \
		gap <= style_gap \
		padding <= style_padding \
		alignItems <= style_align \
		color <= style_color \
		background <= style_back \
		fontSize <= style_font_size \
		fontWeight <= style_weight \
		textAlign <= style_text_align \
	sub <= content /
	Label $mol_view
		sub /
			<= label
	Picture $mol_image
		uri <= uri \
	Editor $mol_string
		value? <=> label?
		attr *
			^
			figmol_edit \true
	- \Blocks of the component library, drawn for real so the canvas shows the
	- \same thing the published site will. Clicks are swallowed by the styles:
	- \picking a block matters here, using it does not.
	Bui_card $bog_builderui_card
		style *
			flexDirection <= inner_direction \
			gap <= inner_gap \
			padding <= inner_padding \
			alignItems <= inner_align \
		sub <= kids /$mol_view
	Bui_button $bog_builderui_button
		title <= label
		variant <= variant \
	Bui_badge $bog_builderui_badge
		title <= label
		variant <= variant \
	Bui_alert $bog_builderui_alert
		title <= label
		text <= note \
	Bui_field $bog_builderui_field
		hint <= label
	Bui_progress $bog_builderui_progress
		value <= progress 0
		max <= progress_max 100
	Bui_tabs $bog_builderui_tabs
		options <= tab_options *
	Bui_avatar $bog_builderui_avatar
		uri <= uri \
	- \An avatar without a picture yet. An <img> with an empty source draws the
	- \browser's broken image icon, which looks like a bug rather than a blank.
	Avatar_stub $mol_view
		sub /
			<= Avatar_icon $mol_icon_account
	Handle_nw $mol_view
		attr *
			^
			figmol_handle \nw
	Handle_ne $mol_view
		attr *
			^
			figmol_handle \ne
	Handle_sw $mol_view
		attr *
			^
			figmol_handle \sw
	Handle_se $mol_view
		attr *
			^
			figmol_handle \se
