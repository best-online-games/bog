$bog_figmol_app_inspector $mol_view
	store $bog_figmol_store
	selected? \
	sub <= rows /$mol_view
	title_text @ \Text
	title_image @ \Image
	title_button @ \Button
	title_rect @ \Rectangle
	title_frame @ \Frame
	Head $mol_view
		sub /
			<= kind_title \
	Field_x $bog_figmol_app_inspector_field
		title @ \X
		content /
			<= X $bog_figmol_app_inspector_number
				value? <=> x? +0
	Field_y $bog_figmol_app_inspector_field
		title @ \Y
		content /
			<= Y $bog_figmol_app_inspector_number
				value? <=> y? +0
	Field_w $bog_figmol_app_inspector_field
		title @ \Width
		content /
			<= W $bog_figmol_app_inspector_number
				value? <=> w? +0
	Field_h $bog_figmol_app_inspector_field
		title @ \Height
		content /
			<= H $bog_figmol_app_inspector_number
				value? <=> h? +0
	Field_direction $bog_figmol_app_inspector_field
		title @ \Layout
		content /
			<= Direction $mol_switch
				value? <=> direction? \
				options *
					free @ \Free
					row @ \Row
					column @ \Column
	Field_gap $bog_figmol_app_inspector_field
		title @ \Gap
		content /
			<= Gap $bog_figmol_app_inspector_number
				value? <=> gap? +0
	Field_padding $bog_figmol_app_inspector_field
		title @ \Padding
		content /
			<= Padding $bog_figmol_app_inspector_number
				value? <=> padding? +0
	Field_align $bog_figmol_app_inspector_field
		title @ \Align
		content /
			<= Align $mol_switch
				value? <=> align? \
				options *
					start @ \Start
					center @ \Center
					end @ \End
					stretch @ \Stretch
	Field_text $bog_figmol_app_inspector_field
		title @ \Content
		content /
			<= Text $mol_textarea
				value? <=> text? \
				hint @ \Type here
	Field_label $bog_figmol_app_inspector_field
		title @ \Caption
		content /
			<= Label $mol_string
				value? <=> text? \
	Field_hint $bog_figmol_app_inspector_field
		title @ \Placeholder
		content /
			<= Hint $mol_string
				value? <=> text? \
	Field_note $bog_figmol_app_inspector_field
		title @ \Note
		content /
			<= Note $mol_textarea
				value? <=> note? \
	Field_size $bog_figmol_app_inspector_field
		title @ \Font size
		content /
			<= Size $bog_figmol_app_inspector_number
				value? <=> font_size? +0
	Field_weight $bog_figmol_app_inspector_field
		title @ \Weight
		content /
			<= Weight $mol_switch
				value? <=> weight? \
				options *
					normal @ \Normal
					bold @ \Bold
	Field_text_align $bog_figmol_app_inspector_field
		title @ \Alignment
		content /
			<= Text_align $mol_switch
				value? <=> text_align? \
				options *
					left @ \Left
					center @ \Center
					right @ \Right
	Field_color $bog_figmol_app_inspector_field
		title @ \Color
		content /
			<= Color $mol_string
				value? <=> color? \
				hint \#111827
	Field_back $bog_figmol_app_inspector_field
		title @ \Background
		content /
			<= Back $mol_string
				value? <=> back? \
				hint \#ffffff
	Field_uri $bog_figmol_app_inspector_field
		title @ \Link
		content /
			<= Uri $mol_string
				value? <=> uri? \
				hint \https://
	Field_variant $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Variant $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					ghost @ \Ghost
	Field_tone $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Tone $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					destructive @ \Danger
	Field_value $bog_figmol_app_inspector_field
		title @ \Value
		content /
			<= Value $bog_figmol_app_inspector_number
				value? <=> progress? +0
	Field_max $bog_figmol_app_inspector_field
		title @ \Maximum
		content /
			<= Max $bog_figmol_app_inspector_number
				value? <=> progress_max? +100
	Field_options $bog_figmol_app_inspector_field
		title @ \Tabs
		content /
			<= Options $mol_string
				value? <=> options? \
				hint \One | Two | Three
	Drop $mol_button_minor
		click? <=> node_drop? null
		sub /
			<= Drop_icon $mol_icon_delete_outline
			<= drop_label @ \Delete element
